# Copy to .env.local (gitignored) and fill in. Keys only: never commit real values.
# See "Environments" in docs/PLAN.md.

# Business timezone (IANA): the default zone for new auctions
AUCTION_TIMEZONE=America/Mexico_City

# MariaDB. Locally through `npm run db:tunnel` (127.0.0.1:3307). On the VPS, 127.0.0.1:3306.
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3307/DATABASE

# Used by scripts/db-*.sh (tunnel, backup)
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY=~/.ssh/your_key
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=
DB_USER=
DB_PASSWORD=
# Optional: DB_REMOTE_PORT=3306, BACKUP_DIR=/root/backups/subastasdelsur, BACKUP_KEEP=20
