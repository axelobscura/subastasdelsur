# Copy to .env.local (gitignored) and fill in. Keys only: never commit real values.
# See "Environments" in docs/PLAN.md.

# Business timezone (IANA): the default zone for new auctions
AUCTION_TIMEZONE=America/Mexico_City

# MariaDB. Locally through `npm run db:tunnel` (127.0.0.1:3307). On the VPS, 127.0.0.1:3306.
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3307/DATABASE

# Used by scripts/db-*.sh (tunnel, backup)
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY=~/.ssh/your_key
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=
DB_USER=
DB_PASSWORD=
# Optional: DB_REMOTE_PORT=3306, BACKUP_DIR=/root/backups/subastasdelsur, BACKUP_KEEP=20

# Email (Hostinger mailbox over SMTP). Quote values with special characters.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=''
EMAIL_FROM="Subastas del sur <admin@subastasdelsur.io>"
ADMIN_NOTIFICATION_EMAIL=
# 1 = log emails instead of sending them
EMAIL_DRY_RUN=0

# Better Auth: the public base URL, and a long random secret (different in production)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Optional extra origins, comma-separated (production: https://www.subastasdelsur.io)
BETTER_AUTH_TRUSTED_ORIGINS=

# Admin account for scripts/seed-admin.ts
ADMIN_EMAIL=
ADMIN_NAME=Administrador
ADMIN_PASSWORD=

# Photos on disk (production: /srv/nextjs/shared/uploads) and the auction currency
UPLOAD_DIR=./.uploads
CURRENCY=MXN

# Auction settlement worker (emails winners when auctions end). 1 ONLY in production:
# dev/test servers share the production DB and must never email real bidders.
SETTLEMENT_WORKER=0
