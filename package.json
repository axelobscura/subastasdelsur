{
  "name": "subastasdelsur",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bash scripts/ensure-tunnel.sh; TZ=UTC next dev",
    "build": "TZ=UTC next build",
    "start": "TZ=UTC next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "TZ=UTC vitest run && TZ=Asia/Tokyo vitest run && TZ=America/Los_Angeles vitest run",
    "test:watch": "TZ=UTC vitest",
    "test:db": "ALLOW_DB_TESTS=1 TZ=Asia/Tokyo vitest run lib/db && ALLOW_DB_TESTS=1 TZ=America/Los_Angeles vitest run lib/db",
    "test:e2e": "playwright test",
    "db:tunnel": "bash scripts/db-tunnel.sh",
    "db:backup": "bash scripts/db-backup.sh",
    "db:check": "tsx scripts/db-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bash scripts/db-backup.sh && drizzle-kit migrate",
    "db:seed-admin": "tsx scripts/seed-admin.ts",
    "test:e2e:flow": "bash scripts/e2e-flow.sh",
    "media:backup": "bash scripts/media-backup.sh",
    "media:sweep": "tsx scripts/media-sweep.ts",
    "db:tunnel:stop": "pkill -f 'ssh.*-L 127.0.0.1:3307:127.0.0.1:3306' && echo 'DB tunnel closed' || echo 'No DB tunnel open'"
  },
  "dependencies": {
    "better-auth": "^1.7.28",
    "drizzle-orm": "^0.45.4",
    "mysql2": "^3.24.6",
    "next": "16.4.6",
    "nodemailer": "^10.6.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.7",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.2"
  }
}
